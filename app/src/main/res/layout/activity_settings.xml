<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView style="@style/SettingsHeading" android:text="Home Assistant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:text="Home Assistant address" />

        <EditText
            android:id="@+id/server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Server, e.g. https://home.example.com:8123"
            android:inputType="textUri" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:text="Long-lived access token" />

        <EditText
            android:id="@+id/token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Long-lived access token"
            android:inputType="textPassword"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Make the token in Home Assistant while logged in as the keypad's user: Profile → Security → Long-lived access tokens → Create token. Copy it and paste it here."
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_test"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Test connection" />

            <TextView
                android:id="@+id/test_result"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView style="@style/SettingsHeading" android:text="Buttons" />

        <LinearLayout
            android:id="@+id/button_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btn_choose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose buttons" />

        <TextView style="@style/SettingsHeading" android:text="Screen" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:text="Title at the top of the keypad (e.g. the room)" />

        <EditText
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Title at the top, e.g. Master bedroom"
            android:inputType="textCapSentences" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:text="Number of tile columns (1-4)" />

        <EditText
            android:id="@+id/columns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Columns (1-4)"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:text="Day from – to (HH:MM). The rest is night." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/day_start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="07:00"
                android:inputType="time" />

            <EditText
                android:id="@+id/day_end"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="23:00"
                android:inputType="time" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:text="Day brightness in use, %. Empty = automatic (light sensor), 0 = the phone's own setting." />

        <EditText
            android:id="@+id/day_level"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="automatic"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:text="Dim after this many seconds without a touch (0 = never)" />

        <EditText
            android:id="@+id/dim_after"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="60"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:text="Day brightness when idle, %" />

        <EditText
            android:id="@+id/day_idle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="30"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:text="Night brightness when idle, % (the tiles are darkened too)" />

        <EditText
            android:id="@+id/dim_percent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="3"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:text="Night brightness when woken, %" />

        <EditText
            android:id="@+id/night_wake"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="20"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:text="Besides a touch, brighten the screen when:" />

        <CheckBox
            android:id="@+id/wake_light"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="the room light goes on (light sensor)" />

        <CheckBox
            android:id="@+id/wake_motion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="someone moves nearby (a shadow on the light sensor)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:textSize="13sp"
            android:text="Movement sensitivity: light change in %. Smaller = more sensitive (5 = very, 15 = normal, 30 = only close by)" />

        <EditText
            android:id="@+id/motion_percent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:hint="15"
            android:inputType="number" />

        <CheckBox
            android:id="@+id/wake_prox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="a hand comes within about 5 cm of the top of the phone (proximity sensor)" />

        <CheckBox
            android:id="@+id/wake_change"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="a device on the keypad is switched elsewhere" />

        <TextView
            android:id="@+id/screen_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:text="PIN to open Settings (empty = no PIN)" />

        <EditText
            android:id="@+id/pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Settings PIN (empty = none)"
            android:inputType="numberPassword" />

        <Button
            android:id="@+id/btn_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Make this the Home app" />

        <TextView style="@style/SettingsHeading" android:text="Wall keypad" />

        <TextView
            android:id="@+id/wall_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/auto_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open the keypad when the phone starts" />

        <CheckBox
            android:id="@+id/kiosk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kiosk: keep the keypad on screen (Home and Recents do nothing; leave via Settings)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:text="Battery: send the level to this Home Assistant input_number (empty = off), e.g. input_number.keypad_battery" />

        <EditText
            android:id="@+id/battery_entity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="input_number.…"
            android:inputType="text" />

        <TextView
            android:id="@+id/battery_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp" />

        <TextView style="@style/SettingsHeading" android:text="Wi-Fi" />

        <TextView
            android:id="@+id/wifi_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wifi_owner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textIsSelectable="true"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/wifi_guard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Look after the Wi-Fi connection" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:text="Wi-Fi network to look after (empty = the current one)" />

        <EditText
            android:id="@+id/wifi_ssid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Wi-Fi network name (empty = the current one)"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:text="Preferred access points, best first (optional; empty = automatic)" />

        <EditText
            android:id="@+id/wifi_aps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="Preferred access points, best first, one per line: name  BSSID (empty = strongest)"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="2"
            android:textSize="13sp"
            android:typeface="monospace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:text="Weakest usable signal, dBm" />

        <EditText
            android:id="@+id/wifi_min_rssi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Weakest usable signal, dBm (e.g. -80)"
            android:inputType="numberSigned" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Every 15 s the keypad checks the Wi-Fi and that Home Assistant answers. If the link stays bad, or a preferred access point is clearly better, it moves the phone to the best access point and keeps it there. Repairs need HA Keypad to be device owner (see above). Android 10 does not let it switch Wi-Fi on if someone switches it off."
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_nearby"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Nearby APs" />

            <Button
                android:id="@+id/btn_wifi_log"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wi-Fi log" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_remove_owner"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stop being device owner" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_cancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save" />
        </LinearLayout>

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
