<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/row_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="14sp" />

    <TextView android:id="@+id/row_up" style="@style/RowIcon" android:text="▲" />
    <TextView android:id="@+id/row_down" style="@style/RowIcon" android:text="▼" />
    <TextView android:id="@+id/row_rename" style="@style/RowIcon" android:text="✎" />
    <TextView android:id="@+id/row_remove" style="@style/RowIcon" android:text="✕" />
</LinearLayout>
